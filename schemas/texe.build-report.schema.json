{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/backmatter/texe/main/schemas/texe.build-report.schema.json",
  "title": "texe build report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "engine",
    "artifact",
    "engine_passes",
    "bibliography_runs",
    "index_runs",
    "convergence_rounds",
    "environment_fingerprint",
    "cached",
    "duration_millis",
    "warning_count",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "texe.build-report/v1" },
    "engine": { "type": "string" },
    "artifact": { "type": "string" },
    "engine_passes": { "type": "integer", "minimum": 0 },
    "bibliography_runs": { "type": "integer", "minimum": 0 },
    "index_runs": { "type": "integer", "minimum": 0 },
    "convergence_rounds": { "type": "integer", "minimum": 0 },
    "environment_fingerprint": { "type": "string" },
    "cached": { "type": "boolean" },
    "duration_millis": { "type": "integer", "minimum": 0 },
    "warning_count": { "type": "integer", "minimum": 0 },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "message"],
        "properties": {
          "kind": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
